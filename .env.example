# =============================================================================
# VN STOCK AI PRO — ENVIRONMENT CONTRACT
# =============================================================================
# Copy to `.env` for local development, or set these in the Google AI Studio
# Secrets / Variables panel. NEVER commit a real value into this file.
#
# The application boots with NONE of these set. Missing services degrade into
# explicit states (see GET /api/health) — they are never faked.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER — RUNTIME
# -----------------------------------------------------------------------------
# PORT: [REQUIRED IN AI STUDIO] Cloud Run / AI Studio forwards a dynamic port.
#       Default 3000 locally. NEVER hardcode this in source.
PORT=3000
# HOST: [OPTIONAL] Bind address. 0.0.0.0 is required in Cloud Run / AI Studio.
HOST=0.0.0.0
# NODE_ENV: [REQUIRED FOR THE PRODUCTION PATH] "production" serves dist/ statically
#       and skips Vite. Leave it unset and `npm start` will try to load Vite, which is
#       a devDependency and absent from a production dependency tree.
NODE_ENV=development
# LOG_LEVEL: [OPTIONAL] DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------
# NOT required to boot or publish. Optional at boot, required for /api/stocks* and
# /api/signals.
# Without it the server still boots, the SPA still loads, and the real KBS/VPS market
# routes (/api/market-data/*, /api/analysis/*, /api/stocks/:symbol/recommendations)
# and the paper-trading router all work. The DB-backed routes answer 500 explicitly.
# They never return synthetic rows.
# SQL_HOST: database host
# SQL_USER: application user
# SQL_PASSWORD: [SECRET]
# SQL_DB_NAME: database name
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
# SQL_PORT: [OPTIONAL] Defaults to 5432. Set it whenever the database is not on the
#   default port — managed instances and sidecar containers publish arbitrary ports,
#   and omitting it dials 5432 and fails with ECONNREFUSED on every DB route.
SQL_PORT=5432
# SQL_SSL: [OPTIONAL] Any value other than false/disable/0 enables TLS. Managed
#   Postgres and Cloud SQL public endpoints REQUIRE this; leaving it unset means
#   plaintext. Values: true | require.
SQL_SSL=
# SQL_SSL_REJECT_UNAUTHORIZED: [OPTIONAL] 'false' (default) allows a private/self-signed
#   managed certificate. Set 'true' when the certificate chain is publicly trusted.
SQL_SSL_REJECT_UNAUTHORIZED=false

# Migration/CLI only (drizzle-kit). Not used at runtime.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# AUTHENTICATION — Firebase Admin (server-side token verification)
# -----------------------------------------------------------------------------
# NEITHER BLOCK BELOW IS REQUIRED TO BOOT, BUILD, START, OR PUBLISH.
# The server starts and every real-data route works with all of them blank. They are
# listed here because AI Studio shows an empty Secrets panel and an operator will
# otherwise assume every name in this file must be filled in.
#
#   Left blank -> /api/health reports `auth: AUTH_CONFIGURATION_REQUIRED`
#                 and protected routes answer 401. Access is DENIED, never bypassed.
#   Set        -> Firebase ID-token verification works for those routes.
#
# FIREBASE_PROJECT_ID: [OPTIONAL] Required only for GET /api/users/me. Falls back to
#                      GOOGLE_CLOUD_PROJECT / GCLOUD_PROJECT on Cloud Run.
#   Credentials come from Application Default Credentials (the attached service
#   account), NOT from a JSON key file. Do not mount a service-account key.
FIREBASE_PROJECT_ID=
# GEMINI_API_KEY: [OPTIONAL] POST /api/ai/chat degrades honestly without it.
#   SECRET — server-side only. AI Studio injects this from user secrets.
#   Never expose it as VITE_*.
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# CLIENT — PUBLIC BUILD VARIABLES (inlined into the browser bundle)
# -----------------------------------------------------------------------------
# [OPTIONAL / CURRENTLY UNREFERENCED BY ANY IMPORTED MODULE]
# These feed src/lib/firebase.ts, which no page, hook, component or service imports,
# so they are currently tree-shaken out of the bundle and no browser code reads them
# (verified: 0 occurrences of VITE_FIREBASE_API_KEY in dist/assets/index-*.js).
# They are kept because client sign-in is a real product capability awaiting an
# authenticated UI, not because startup needs them. Set none of them to boot.
#
# Only the public Firebase *web* values belong here. Anything in a VITE_* variable
# is readable by every visitor. NEVER put a secret in one of these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# APP_URL: [OPTIONAL / UNUSED BY CODE] No module reads this. AI Studio injects the
#   public URL itself; kept for the platform convention only.
APP_URL=

# DISABLE_HMR: [DEVELOPMENT] "true" turns off Vite HMR + file watching during
#   agent edits (AI Studio sets this itself).
DISABLE_HMR=false

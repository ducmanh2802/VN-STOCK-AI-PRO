# =============================================================================
# VN STOCK AI PRO — ENVIRONMENT CONTRACT
# =============================================================================
# Copy to `.env` for local development, or set these in the Google AI Studio
# Secrets / Variables panel. NEVER commit a real value into this file.
#
# The application boots with NONE of these set. Missing services degrade into
# explicit states (see GET /api/health) — they are never faked.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER — RUNTIME
# -----------------------------------------------------------------------------
# PORT: [REQUIRED in AI Studio] Cloud Run / AI Studio forwards a dynamic port.
#       Default 3000 locally. NEVER hardcode this in source.
PORT=3000
# HOST: [OPTIONAL] Bind address. 0.0.0.0 is required in Cloud Run.
HOST=0.0.0.0
# NODE_ENV: [PRODUCTION] "production" serves dist/ statically and skips Vite.
NODE_ENV=development
# LOG_LEVEL: [OPTIONAL] DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL via Cloud SQL
# -----------------------------------------------------------------------------
# All four are REQUIRED for every /api/stocks* and /api/signals route.
# Without them the server still boots and those routes answer 500 explicitly;
# they never return synthetic rows.
# SQL_HOST: Cloud SQL connection host (e.g. 10.x.x.x or the public IP)
# SQL_USER: application user
# SQL_PASSWORD: [SECRET]
# SQL_DB_NAME: database name
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# Migration/CLI only (drizzle-kit). Not used at runtime.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# AUTHENTICATION — Firebase Admin (server-side token verification)
# -----------------------------------------------------------------------------
# FIREBASE_PROJECT_ID: [REQUIRED for /api/users/me] Falls back to
#                      GOOGLE_CLOUD_PROJECT / GCLOUD_PROJECT on Cloud Run.
#   Credentials come from Application Default Credentials (the attached service
#   account), NOT from a JSON key file. Do not mount a service-account key.
#   When unset, requireAuth answers 401 AUTH_CONFIGURATION_REQUIRED — access is
#   denied, never bypassed.
FIREBASE_PROJECT_ID=
# GEMINI_API_KEY: [REQUIRED for /api/ai/chat] SECRET — server-side only.
#   AI Studio injects this from user secrets. Never expose it as VITE_*.
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# CLIENT — PUBLIC BUILD VARIABLES (inlined into the browser bundle)
# -----------------------------------------------------------------------------
# Only the public Firebase *web* values belong here. Anything in a VITE_* variable
# is readable by every visitor. NEVER put a secret in one of these.
# FIREBASE_API_KEY: public web API key (Firebase client key, not a secret)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# APP_URL: [OPTIONAL] Public URL, injected by AI Studio with the Cloud Run URL.
APP_URL=

# DISABLE_HMR: [DEVELOPMENT] "true" turns off Vite HMR + file watching during
#   agent edits (AI Studio sets this itself).
DISABLE_HMR=false
